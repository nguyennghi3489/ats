{
  "name": "@ats/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deps:build": "pnpm --filter @ats/shared build",
    "dev": "pnpm deps:build && vite",
    "build": "pnpm deps:build && vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm deps:build && vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm deps:build && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@ats/shared": "workspace:*",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "better-auth": "^1.7.11",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
