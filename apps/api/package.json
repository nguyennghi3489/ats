{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deps:build": "pnpm --filter @ats/shared build",
    "dev": "pnpm deps:build && tsc -p tsconfig.build.json && pnpm run \"/^dev:/\"",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:server": "node --env-file=.env.example --env-file-if-exists=../../.env --env-file-if-exists=.env --watch-path=dist --watch-preserve-output dist/main.js",
    "worker:dev": "pnpm deps:build && tsc -p tsconfig.build.json && pnpm run \"/^worker:dev:/\"",
    "worker:dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "worker:dev:run": "node --env-file=.env.example --env-file-if-exists=../../.env --env-file-if-exists=.env --watch-path=dist --watch-preserve-output dist/main.worker.js",
    "queue:ping": "node --env-file=.env.example --env-file-if-exists=../../.env --env-file-if-exists=.env dist/queue/enqueue-ping.js",
    "db:migrate": "pnpm build && node --env-file=.env.example --env-file-if-exists=../../.env --env-file-if-exists=.env dist/database/migrate.js",
    "db:reset": "pnpm build && node --env-file=.env.example --env-file-if-exists=../../.env --env-file-if-exists=.env dist/database/reset.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate:create": "drizzle-kit generate --custom",
    "build": "pnpm deps:build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker:start": "node dist/main.worker.js",
    "typecheck": "pnpm deps:build && tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm deps:build && vitest run --dir src",
    "test:integration": "pnpm deps:build && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@ats/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "better-auth": "^1.7.11",
    "bullmq": "^6.3.16",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
