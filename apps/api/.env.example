# API settings. `pnpm --filter api dev` loads this file first, then the root `.env` and `apps/api/.env`
# (both git-ignored, later files win). Variables already set in the shell win over every file.
# Production sets these in the Compose environment; `pnpm --filter api start` reads no file.

# development | test | production
NODE_ENV=development
# Port the HTTP server listens on. Required.
API_PORT=3000
# Lowest level written: verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
# Redis for BullMQ queues and auth resend limits (Compose service `redis`). Required by the API, the worker and `queue:ping`.
REDIS_URL=redis://127.0.0.1:6379
# Postgres (Compose service `postgres`). Required by the API, `db:migrate` and `db:reset`.
DATABASE_URL=postgres://ats:ats@127.0.0.1:5432/ats
# Better Auth (decisions §2). Signs session cookies: at least 32 characters. Required.
# This value is for local development only; production generates its own (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=local-dev-only-better-auth-secret-change-me
# Public URL of the API. Required.
BETTER_AUTH_URL=http://localhost:3000
# Origin of the recruiter web app (Vite dev server); the only origin trusted by the auth endpoints. Required.
WEB_ORIGIN=http://localhost:5173
# SMTP the worker sends email through. Required by the worker. Defaults: Compose service `mailpit`
# (no TLS, no credentials; read the mail at http://127.0.0.1:8025). Production: Resend over SMTP.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# true = TLS from the first byte (port 465); false = plain, upgraded with STARTTLS when offered.
SMTP_SECURE=false
# Set both or neither. Mailpit accepts any.
SMTP_USER=
SMTP_PASSWORD=
# Sender of every email: an address, optionally with a name.
EMAIL_FROM="ATS <no-reply@example.test>"
