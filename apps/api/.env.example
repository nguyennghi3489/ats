# API settings. `pnpm --filter api dev` loads this file first, then the root `.env` and `apps/api/.env`
# (both git-ignored, later files win). Variables already set in the shell win over every file.
# Production sets these in the Compose environment; `pnpm --filter api start` reads no file.

# development | test | production
NODE_ENV=development
# Port the HTTP server listens on. Required.
API_PORT=3000
# Lowest level written: verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
