# Local development values. They match the defaults in docker-compose.yml.
# Copy to .env (git-ignored) and change what you need:  cp .env.example .env
# These credentials are for the local stack only; never reuse them anywhere else.

# --- PostgreSQL (service: postgres) ---
POSTGRES_USER=ats
POSTGRES_PASSWORD=ats
POSTGRES_DB=ats
POSTGRES_TEST_DB=ats_test
POSTGRES_PORT=5432
DATABASE_URL=postgres://ats:ats@127.0.0.1:5432/ats
TEST_DATABASE_URL=postgres://ats:ats@127.0.0.1:5432/ats_test

# --- Redis (service: redis) ---
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# --- S3 API (service: versitygw) ---
S3_PORT=7070
S3_ENDPOINT=http://127.0.0.1:7070
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ats-dev-access-key
S3_SECRET_ACCESS_KEY=ats-dev-secret-key
S3_BUCKET=ats-dev
S3_FORCE_PATH_STYLE=true

# --- Email (service: mailpit) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Mailpit needs no credentials. Set both for a real SMTP server (production: Resend).
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ATS <no-reply@example.test>"
MAILPIT_UI_PORT=8025
MAILPIT_URL=http://127.0.0.1:8025

# --- CV conversion (service: docling-serve) ---
DOCLING_PORT=5001
DOCLING_URL=http://127.0.0.1:5001

# --- Authentication (api, Better Auth) ---
# Local development only; production sets its own secret (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=local-dev-only-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
