# Production values for docker-compose.prod.yml. Placeholders only: never commit the real file.
# On the Droplet:  cp .env.prod.example /opt/ats/.env && chmod 600 /opt/ats/.env   then replace every value.
# Generate secrets with:  openssl rand -hex 32   (hex keeps them URL-safe, DATABASE_URL embeds the password).

# --- Public site (service: caddy) ---
# Domain Caddy serves and gets a certificate for. `localhost` uses Caddy's local CA (testing only).
DOMAIN=ats.example.com
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com

# --- Images (services: api, worker, web) ---
# Tag of ghcr.io/nguyennghi3489/ats-api and ats-web to run (a release tag or commit SHA; default latest).
IMAGE_TAG=latest

# --- API and worker ---
# Lowest log level written: verbose | debug | log | warn | error | fatal.
LOG_LEVEL=log
# Signs session cookies. At least 32 random bytes; changing it signs everyone out.
SESSION_SECRET=replace-with-openssl-rand-hex-32

# --- PostgreSQL (services: postgres, pg-backup; api/worker get DATABASE_URL built from these) ---
# Database owner created on first start. Changing these later does not change an existing volume.
POSTGRES_USER=ats
# URL-safe password (letters and digits only).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# App database name.
POSTGRES_DB=ats

# --- S3 API (service: versitygw) ---
# Region name the S3 clients sign with.
S3_REGION=us-east-1
# versitygw root access key, also used by the api and worker.
S3_ACCESS_KEY_ID=replace-with-access-key
# versitygw root secret key.
S3_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-32
# Bucket for CVs and attachments; created on start.
S3_BUCKET=ats-files

# --- Email over SMTP (Resend, decisions §1) ---
# SMTP server host.
SMTP_HOST=smtp.resend.com
# SMTP port: 465 with SMTP_SECURE=true (implicit TLS), 587 with SMTP_SECURE=false (STARTTLS).
SMTP_PORT=465
# true for implicit TLS on connect.
SMTP_SECURE=true
# SMTP user name (`resend` for Resend).
SMTP_USER=resend
# SMTP password (the Resend API key).
SMTP_PASSWORD=replace-with-resend-api-key
# Sender address; its domain must be verified with the email provider.
MAIL_FROM="ATS <no-reply@example.com>"

# --- Backups (service: pg-backup) ---
# Cron schedule (minute hour day month weekday) of the nightly pg_dump, in BACKUP_TZ.
BACKUP_SCHEDULE="0 3 * * *"
# Time zone of BACKUP_SCHEDULE and of the dump file names.
BACKUP_TZ=Asia/Ho_Chi_Minh
