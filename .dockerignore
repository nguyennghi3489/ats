# Build context for apps/api/Dockerfile and apps/web/Dockerfile (both built from the repo root).
# Only sources, manifests and the lockfile go in; images install and build everything themselves.

# Dependencies and build output: rebuilt inside the image
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo

# Secrets and local settings: never baked into an image (.env.example files stay)
**/.env
**/.env.*
!**/.env.example

# Tests output, logs, OS and editor files
**/playwright-report
**/test-results
**/blob-report
**/*.log
**/.DS_Store
.idea
.vscode

# Not needed to build
.git
.github
.claude
docs
docker
scripts
**/Dockerfile
.dockerignore
